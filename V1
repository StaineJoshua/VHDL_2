#include "xparameters.h"
#include "xgpiops.h"
#include "xuartps.h"
#include "sleep.h"

#define LED_PIN 47   // MIO pin for LED DS23

int main() {
    XGpioPs Gpio;               // GPIO driver instance
    XGpioPs_Config *ConfigPtr;
    XUartPs Uart;                // UART driver instance
    XUartPs_Config *UartConfig;

    // Initialize GPIO
    ConfigPtr = XGpioPs_LookupConfig(XPAR_XGPIOPS_0_DEVICE_ID);
    XGpioPs_CfgInitialize(&Gpio, ConfigPtr, ConfigPtr->BaseAddr);
    XGpioPs_SetDirectionPin(&Gpio, LED_PIN, 1);
    XGpioPs_SetOutputEnablePin(&Gpio, LED_PIN, 1);

    // Initialize UART (PS UART0)
    UartConfig = XUartPs_LookupConfig(XPAR_XUARTPS_0_DEVICE_ID);
    XUartPs_CfgInitialize(&Uart, UartConfig, UartConfig->BaseAddress);

    // Configure baud rate (115200 typical)
    XUartPs_SetBaudRate(&Uart, 115200);

    while (1) {
        // Print message
        char msg[] = "Hello World from Zynq!\r\n";
        XUartPs_Send(&Uart, (u8*)msg, sizeof(msg)-1);

        // Blink LED ON
        XGpioPs_WritePin(&Gpio, LED_PIN, 1);
        sleep(1);

        // Blink LED OFF
        XGpioPs_WritePin(&Gpio, LED_PIN, 0);
        sleep(1);
    }

    return 0;
}


#include "xgpiops.h"
#include "xparameters.h"
#include "xil_printf.h"
#include "sleep.h"

#define LED_MIO 7   // ZC706 LED connected to MIO 7

XGpioPs Gpio;      // GPIO driver instance

int main()
{
    int Status;
    XGpioPs_Config *ConfigPtr;

    xil_printf("ZC706 PS LED Blink Example\r\n");

    // Initialize GPIO driver
    ConfigPtr = XGpioPs_LookupConfig(XPAR_XGPIOPS_0_DEVICE_ID);
    Status = XGpioPs_CfgInitialize(&Gpio, ConfigPtr, ConfigPtr->BaseAddr);

    if (Status != XST_SUCCESS) {
        xil_printf("GPIO Initialization Failed\r\n");
        return XST_FAILURE;
    }

    // Set LED pin direction to output
    XGpioPs_SetDirectionPin(&Gpio, LED_MIO, 1);

    // Enable output
    XGpioPs_SetOutputEnablePin(&Gpio, LED_MIO, 1);

    while (1) {
        // LED ON
        XGpioPs_WritePin(&Gpio, LED_MIO, 1);
        sleep(1);

        // LED OFF
        XGpioPs_WritePin(&Gpio, LED_MIO, 0);
        sleep(1);
    }
}


